# MongoDB local o Atlas
MONGO_URI=mongodb://127.0.0.1:27017/talento60

# Clave para firmar los tokens de sesión
JWT_SECRET=cambia_esta_clave_por_una_larga_y_segura

# Origen permitido en producción (GitHub Pages). En local se puede dejar vacío.
FRONTEND_URL=

# IA opcional: si no hay clave, el Asistente creativo usa plantillas
AI_API_KEY=
# Proveedor compatible con OpenAI. Ejemplo Groq: https://api.groq.com/openai/v1/chat/completions
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Cloudinary: subida directa de videos desde el navegador.
# La API secret solo va en el backend; nunca en React.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Puerto del backend
PORT=3000
